# Entorno: development | production | test
NODE_ENV=development

# Servidor
PORT=3000

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=siga
DB_USER=siga_app
DB_PASSWORD=cambia_esta_contrasena

# Sesiones (genera una cadena larga y aleatoria; ver README)
SESSION_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio

# Origen permitido para CORS (el mismo del servidor en desarrollo)
CORS_ORIGIN=http://localhost:3000